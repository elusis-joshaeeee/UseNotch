{
  "name": "creditnotch",
  "version": "1.0.0",
  "description": "Menu bar app to track Codec CLI and Claude Code credits",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "dist": "electron-builder --publish=always"
  },
  "keywords": ["menubar", "credits", "codec", "claude", "ai"],
  "author": "Shivansh & Elusis",
  "license": "MIT",
  "build": {
    "appId": "com.shivansh.creditnotch",
    "productName": "CreditNotch",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],

    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "icon.png"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "menubar": "^9.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elusis-joshaeeee/UseNotch.git"
  },
  "homepage": "https://github.com/elusis-joshaeeee/UseNotch"
}
